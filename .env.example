# Copy to .env.local for local development, and set the same variables in
# your hosting provider (e.g. Vercel → Project → Settings → Environment Variables).

# The public address of the site, with no trailing slash. Used to build the
# absolute URLs that link previews (Open Graph / social share images) need.
# Without it, shared links point their preview images at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
