{
  "version": 8,
  "name": "BH\u0100RATA Atlas",
  "glyphs": "/map-glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "carto": {
      "type": "vector",
      "url": "https://tiles.basemaps.cartocdn.com/vector/carto.streets/v1/tiles.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "background-color": "#f3ede0"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "carto",
      "source-layer": "landcover",
      "filter": [
        "any",
        [
          "==",
          "class",
          "wood"
        ],
        [
          "==",
          "class",
          "grass"
        ],
        [
          "==",
          "subclass",
          "recreation_ground"
        ]
      ],
      "paint": {
        "fill-color": "rgba(168, 156, 107, 0.16)"
      }
    },
    {
      "id": "park_national_park",
      "type": "fill",
      "source": "carto",
      "source-layer": "park",
      "minzoom": 9,
      "filter": [
        "all",
        [
          "==",
          "class",
          "national_park"
        ]
      ],
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "rgba(168, 156, 107, 0.16)"
      }
    },
    {
      "id": "park_nature_reserve",
      "type": "fill",
      "source": "carto",
      "source-layer": "park",
      "minzoom": 0,
      "filter": [
        "all",
        [
          "==",
          "class",
          "nature_reserve"
        ]
      ],
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "rgba(168, 156, 107, 0.16)"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "carto",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#6f8f83",
        "line-width": {
          "stops": [
            [
              8,
              0.5
            ],
            [
              9,
              1
            ],
            [
              15,
              2
            ],
            [
              16,
              3
            ]
          ]
        }
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "carto",
      "source-layer": "water",
      "minzoom": 0,
      "maxzoom": 24,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ]
      ],
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "#a9c2b7",
        "fill-antialias": true
      }
    },
