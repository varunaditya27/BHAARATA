      "id": "watername_ocean",
      "type": "symbol",
      "source": "carto",
      "source-layer": "water_name",
      "minzoom": 0,
      "maxzoom": 5,
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "==",
          "$type",
          "Point"
        ],
        [
          "==",
          "class",
          "ocean"
        ]
      ],
      "layout": {
        "text-field": "{name}",
        "symbol-placement": "point",
        "text-size": {
          "stops": [
